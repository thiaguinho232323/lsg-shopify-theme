<section id="como-adquirir" class="sec" style="scroll-margin-top:80px">
  <div class="wrap">
    <div class="reveal" data-reveal>
      <p class="kicker">{{ section.settings.kicker }}</p>
      <h2 class="title t-xl" style="margin-top:20px">{{ section.settings.title }}</h2>
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step reveal" data-reveal style="transition-delay:{{ forloop.index0 | times: 120 }}ms" {{ block.shopify_attributes }}>
          <span class="step-n">{{ block.settings.n }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Inicio · Cómo adquirir",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto superior", "default": "Atención personalizada" },
    { "type": "text", "id": "title", "label": "Título", "default": "Cómo adquirir una pieza" }
  ],
  "blocks": [
    { "type": "paso", "name": "Paso", "settings": [
      { "type": "text", "id": "n", "label": "Número", "default": "01" },
      { "type": "text", "id": "title", "label": "Título" },
      { "type": "textarea", "id": "text", "label": "Texto" }
    ] }
  ],
  "presets": [{ "name": "Inicio · Cómo adquirir" }]
}
{% endschema %}
