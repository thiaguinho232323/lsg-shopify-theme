<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0A0A0A">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>
      {%- if template.name == 'index' -%}LSG — Luxury Selection Gallery{%- else -%}{{ page_title }} · LSG{%- endif -%}
    </title>
    {% render 'social-meta' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,500&family=Jost:wght@300;400;500&display=swap">
    {{ 'lsg.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.add('js');</script>
    {{ content_for_header }}
  </head>
  <body class="tpl-{{ template.name }}">
    <a class="sr-only" href="#main">Ir al contenido</a>
    {% section 'header' %}
    <main id="main">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
    {% render 'wa-float' %}
    <script src="{{ 'lsg.js' | asset_url }}" defer></script>
  <script src="{{ 'lsg-cart.js' | asset_url }}" defer></script>
  </body>
</html>
