{%- comment -%}
  Meta tags para buscadores y para cuando se comparte un link (WhatsApp, Instagram, Facebook, X).
  Imagen general: assets/lsg-share.jpg · En productos usa la foto de la pieza.
{%- endcomment -%}
{%- assign sm_site = 'LSG — Luxury Selection Gallery' -%}
{%- assign sm_desc_home = 'Piezas de diseñador originales, seleccionadas una a una: Louis Vuitton, Balenciaga, Amiri, Off-White, Loewe y Supreme. Cada pieza con su estado (NEW · VNDS · USED), precios en USD, envíos a todo el país y atención directa por WhatsApp.' -%}
{%- assign sm_type = 'website' -%}
{%- assign sm_img = 'lsg-share.jpg' | asset_url | prepend: 'https:' -%}
{%- assign sm_img_w = 1200 -%}{%- assign sm_img_h = 630 -%}
{%- assign sm_img_alt = 'LSG — Luxury Selection Gallery. Elegido para pocos.' -%}

{%- if template.name == 'index' -%}
  {%- assign sm_title = 'LSG — Luxury Selection Gallery · Piezas de diseñador originales en Argentina' -%}
  {%- assign sm_desc = sm_desc_home -%}

{%- elsif template.name == 'product' and product -%}
  {%- assign sm_type = 'product' -%}
  {%- assign sm_cond = '' -%}
  {%- for tag in product.tags -%}{%- assign tl = tag | downcase -%}{%- if tl contains 'condicion:' -%}{%- assign sm_cond = tag | split: ':' | last | strip | upcase -%}{%- endif -%}{%- endfor -%}
  {%- case sm_cond -%}
    {%- when 'DS' or 'NEW' -%}{%- assign sm_cond_txt = 'NEW (nueva)' -%}
    {%- when 'VNDS' -%}{%- assign sm_cond_txt = 'VNDS (igual a nueva)' -%}
    {%- when 'USED' -%}{%- assign sm_cond_txt = 'USED (excelente estado)' -%}
    {%- else -%}{%- assign sm_cond_txt = sm_cond -%}
  {%- endcase -%}
  {%- assign sm_talle = '' -%}
  {%- for option in product.options_with_values -%}{%- assign on = option.name | downcase -%}{%- if on contains 'talle' or on contains 'talla' or on contains 'size' -%}{%- assign sm_talle = option.values | join: ' / ' -%}{%- endif -%}{%- endfor -%}
  {%- if sm_talle == '' -%}{%- for s in product.metafields.shopify.size.value -%}{%- if forloop.first -%}{%- assign sm_talle = s.label -%}{%- else -%}{%- assign sm_talle = sm_talle | append: ' / ' | append: s.label -%}{%- endif -%}{%- endfor -%}{%- endif -%}
  {%- capture sm_price -%}USD {{ product.price | money_without_currency | strip_html | remove: '.00' | replace: ',', '.' }}{%- endcapture -%}
  {%- capture sm_title -%}{{ product.title }} · {% if product.available %}{{ sm_price }}{% else %}Vendida{% endif %} · LSG{%- endcapture -%}
  {%- capture sm_desc -%}{{ product.vendor }}{% if sm_talle != '' %} · Talle {{ sm_talle }}{% endif %}{% if sm_cond_txt != '' %} · Estado {{ sm_cond_txt }}{% endif %}. {% if product.available %}Pieza original seleccionada por LSG. Consultá por WhatsApp, envíos a todo el país.{% else %}Esta pieza ya se vendió: podemos conseguirla por encargo.{% endif %}{%- endcapture -%}
  {%- if product.featured_image -%}
    {%- assign sm_img = product.featured_image | image_url: width: 1200, format: 'jpg' | prepend: 'https:' -%}
    {%- assign sm_img_w = 1200 -%}{%- assign sm_img_h = 1200 | times: product.featured_image.height | divided_by: product.featured_image.width -%}
    {%- assign sm_img_alt = product.title -%}
  {%- endif -%}

{%- elsif template.name == 'collection' and collection -%}
  {%- capture sm_title -%}{% if collection.handle == 'all' %}La selección{% else %}{{ collection.title }}{% endif %} · Piezas de diseñador originales · LSG{%- endcapture -%}
  {%- if collection.description != blank -%}{%- assign sm_desc = collection.description | strip_html | strip_newlines | truncate: 200 -%}{%- else -%}{%- assign sm_desc = sm_desc_home -%}{%- endif -%}

{%- else -%}
  {%- capture sm_title -%}{{ page_title }} · LSG{%- endcapture -%}
  {%- if page_description -%}{%- assign sm_desc = page_description | strip_newlines -%}{%- else -%}{%- assign sm_desc = sm_desc_home -%}{%- endif -%}
{%- endif -%}

<meta name="description" content="{{ sm_desc | strip | escape }}">
<meta property="og:site_name" content="{{ sm_site }}">
<meta property="og:locale" content="es_AR">
<meta property="og:type" content="{{ sm_type }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ sm_title | strip | escape }}">
<meta property="og:description" content="{{ sm_desc | strip | escape }}">
<meta property="og:image" content="{{ sm_img }}">
<meta property="og:image:secure_url" content="{{ sm_img }}">
<meta property="og:image:width" content="{{ sm_img_w }}">
<meta property="og:image:height" content="{{ sm_img_h }}">
<meta property="og:image:alt" content="{{ sm_img_alt | escape }}">
{%- if sm_type == 'product' %}
<meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
<meta property="product:price:currency" content="USD">
<meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ sm_title | strip | escape }}">
<meta name="twitter:description" content="{{ sm_desc | strip | escape }}">
<meta name="twitter:image" content="{{ sm_img }}">
<link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
<link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon-192.png' | asset_url }}">
<link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
<meta name="apple-mobile-web-app-title" content="LSG">
