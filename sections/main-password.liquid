<div class="plain pw">
  {% render 'monogram', full: true %}
  <h1>Elegido <span class="gold">para pocos.</span></h1>
  <p>Estamos preparando la selección. Muy pronto.</p>
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <input type="password" name="password" placeholder="Contraseña" aria-label="Contraseña"><br>
    <button type="submit" class="btn btn-ghost">Entrar</button>
  {%- endform -%}
</div>
{% schema %}{ "name": "Contraseña", "settings": [] }{% endschema %}
