{%- capture wa -%}{% render 'wa-url', message: 'Hola LSG. Estoy buscando una pieza y quería consultarles.' %}{%- endcapture -%}
<footer class="ftr">
  <div class="wrap ftr-in">
    <div class="ftr-top">
      <div class="ftr-brand">
        <a href="{{ routes.root_url }}" aria-label="LSG — Inicio"><span class="lsg-wm">Luxury Selection <em>Gallery</em></span></a>
      </div>
      <div class="ftr-links">
        <a href="{{ routes.all_products_collection_url }}">Selección</a>
        <a href="{{ settings.instagram }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %} Instagram</a>
        <a href="{{ routes.root_url }}#nuestra-mirada">Nuestra mirada</a>
        <a href="{{ settings.tiktok }}" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %} TikTok</a>
        <a href="{{ routes.root_url }}#como-adquirir">Cómo adquirir</a>
        <a href="{{ wa | strip }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %} WhatsApp</a>
        <a href="/pages/envios-y-pagos">Envíos y pagos</a>
      </div>
    </div>
    <div class="ftr-bot">
      <span>Solo online · Envíos a todo el país · Precios en USD</span>
      <span>© {{ 'now' | date: '%Y' }} Luxury Selection Gallery</span>
    </div>
  </div>
</footer>
{% schema %}
{ "name": "Pie de página", "settings": [ { "type": "text", "id": "tagline", "label": "Frase", "default": "Elegido para pocos." } ] }
{% endschema %}
