<section id="glosario" class="sec glos" style="scroll-margin-top:80px">
    <div class="wrap">
    <div class="glos-head reveal" data-reveal>
    <div>
    <p class="kicker">{{ section.settings.kicker }}</p>
    <h2 class="title t-xl" style="margin-top:20px">{{ section.settings.title }} <span class="gold">{{ section.settings.title_gold }}</span></h2>
    </div>
    {%- capture glos_wa -%}{% render 'wa-url', message: 'Hola LSG. Quería consultar por el estado de una pieza.' %}{%- endcapture -%}<p class="glos-intro">{{ section.settings.intro }} ¿Querés ver una pieza en detalle? Pedinos fotos, videos o hacenos cualquier consulta por <a href="{{ glos_wa | strip }}" target="_blank" rel="noopener" class="glos-wa">WhatsApp</a>.</p>
    </div>
    <div class="glos-list">
    {%- for block in section.blocks -%}
    <div class="glos-row reveal" data-reveal style="transition-delay:{{ forloop.index0 | times: 120 }}ms" {{ block.shopify_attributes }}>
    <span class="glos-code">{{ block.settings.code }}{%- if block.settings.alias != blank -%}<span class="glos-alt">{{ block.settings.alias }}</span>{%- endif -%}</span>
    <div><span class="glos-name">{{ block.settings.name }}</span>{%- if block.settings.full != blank -%}<span class="glos-full">{{ block.settings.full }}</span>{%- endif -%}</div>
    <p class="glos-text">{{ block.settings.text }}</p>
    </div>
    {%- endfor -%}
    </div>
    </div>
    </section>
    {% schema %}
    {
    "name": "Inicio · Glosario",
    "settings": [
    { "type": "text", "id": "kicker", "label": "Texto superior", "default": "Glosario" },
    { "type": "text", "id": "title", "label": "Título", "default": "El estado de cada pieza," },
    { "type": "text", "id": "title_gold", "label": "Título en dorado", "default": "sin letra chica." },
    { "type": "textarea", "id": "intro", "label": "Introducción", "default": "Declaramos el estado de cada pieza con la misma precisión con la que la elegimos. Tres términos, una sola promesa: transparencia total sobre cada pieza que recibís." }
    ],
    "blocks": [
    { "type": "term", "name": "Término", "settings": [
    { "type": "text", "id": "code", "label": "Sigla", "default": "NEW" }, { "type": "text", "id": "alias", "label": "Sigla equivalente (opcional)" },
    { "type": "text", "id": "name", "label": "Nombre", "default": "Nueva" },
    { "type": "text", "id": "full", "label": "Significado de la sigla" },
    { "type": "textarea", "id": "text", "label": "Descripción" }
    ] }
    ],
    "presets": [
    { "name": "Glosario", "blocks": [
    { "type": "term", "settings": { "code": "NEW", "alias": "DS", "name": "Nueva", "full": "Deadstock", "text": "Sin uso. Con sus etiquetas o en su caja original, tal como salió de la casa." } },
    { "type": "term", "settings": { "code": "VNDS", "name": "Igual a nueva", "full": "Very Near Deadstock", "text": "Entre 2 y 3 usos, sin marcas ni detalles visibles. A la vista y al tacto, está igual a nueva." } },
    { "type": "term", "settings": { "code": "USED", "name": "Usada · excelente estado", "full": "Pre-owned", "text": "Con uso y en excelente estado, revisada en detalle. Escribinos por WhatsApp y te mostramos su condición real." } }
    ] }
    ]
    }
    {% endschema %}
    