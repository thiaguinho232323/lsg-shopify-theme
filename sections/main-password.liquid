<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@200;300;400&display=swap" rel="stylesheet">
<style>
html,body{background:#050505!important;overflow:hidden!important}
.lsgp{position:fixed;inset:0;z-index:2147483000;background:#050505;color:#ede8df;font-family:Jost,system-ui,sans-serif;font-weight:300;display:flex;flex-direction:column;overflow:hidden;-webkit-font-smoothing:antialiased}
.lsgp *{box-sizing:border-box}
.lsgp__media{position:absolute;inset:0;z-index:0}
.lsgp__media video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.08);opacity:0;transform:scale(1.06);transition:opacity 1.8s ease,transform 9s ease-out}
.lsgp__media video.on{opacity:1;transform:scale(1)}
.lsgp__shade{position:absolute;inset:0;z-index:1;background:radial-gradient(ellipse at center,rgba(5,5,5,.25) 0%,rgba(5,5,5,.75) 70%,rgba(5,5,5,.95) 100%),linear-gradient(180deg,rgba(5,5,5,.7) 0%,rgba(5,5,5,.2) 35%,rgba(5,5,5,.85) 100%)}
.lsgp__grain{position:absolute;inset:-50%;z-index:2;pointer-events:none;opacity:.07;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");animation:lsgpGrain 1.2s steps(6) infinite}
@keyframes lsgpGrain{0%{transform:translate(0,0)}20%{transform:translate(-4%,3%)}40%{transform:translate(3%,-5%)}60%{transform:translate(-6%,-2%)}80%{transform:translate(5%,4%)}100%{transform:translate(0,0)}}
.lsgp__frame{position:absolute;inset:18px;z-index:3;border:1px solid rgba(198,166,100,.22);pointer-events:none}
.lsgp__top,.lsgp__bottom{position:relative;z-index:4;display:flex;justify-content:space-between;align-items:center;padding:38px 48px;font-size:10px;letter-spacing:.32em;text-transform:uppercase;color:rgba(237,232,223,.6)}
.lsgp__logo{font-family:"Cormorant Garamond",Georgia,serif;font-weight:500;font-size:13px;letter-spacing:.24em;color:#ede8df;text-transform:uppercase}
.lsgp__logo em{color:#c6a664;font-style:normal}
.lsgp__main{position:relative;z-index:4;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:0 24px}
.lsgp__kicker{font-size:10px;letter-spacing:.42em;text-transform:uppercase;color:#c6a664;margin:0 0 28px}
.lsgp__title{margin:0;font-weight:200;font-size:clamp(56px,11vw,150px);line-height:.92;letter-spacing:-.02em}
.lsgp__title span{display:block}
.lsgp__title .sheen{font-family:"Cormorant Garamond",Georgia,serif;font-style:italic;font-weight:400;background:linear-gradient(110deg,#8a7243,#9c7a3c 35%,#f3e3bb 50%,#9c7a3c 65%,#8a7243);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:lsgpSheen 6s ease-in-out infinite}
@keyframes lsgpSheen{0%,100%{background-position:100% 0}50%{background-position:0 0}}
.lsgp__line{width:1px;height:46px;background:linear-gradient(#c6a664,transparent);margin:34px auto 26px}
.lsgp__sub{max-width:420px;margin:0 auto 34px;font-size:14px;line-height:1.75;letter-spacing:.02em;color:rgba(237,232,223,.72)}
.lsgp__form{display:flex;align-items:stretch;width:100%;max-width:400px;margin:0 auto;border-bottom:1px solid rgba(237,232,223,.35);transition:border-color .4s}
.lsgp__form:focus-within{border-color:#c6a664}
.lsgp__form input[type=password]{flex:1;min-width:0;background:transparent;border:0;outline:0;color:#ede8df;font:300 13px Jost,system-ui,sans-serif;letter-spacing:.3em;padding:16px 4px;text-transform:none}
.lsgp__form input::placeholder{color:rgba(237,232,223,.45);letter-spacing:.3em;text-transform:uppercase;font-size:10px}
.lsgp__form button{background:transparent;border:0;color:#c6a664;font:400 10px Jost,system-ui,sans-serif;letter-spacing:.34em;text-transform:uppercase;padding:0 4px 0 16px;cursor:pointer;display:flex;align-items:center;gap:10px;transition:gap .3s,color .3s}
.lsgp__form button:hover{gap:16px;color:#f3e3bb}
.lsgp__err{margin:16px 0 0;font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:#d98a7a;min-height:14px}
.lsgp__form.shake{animation:lsgpShake .5s}
@keyframes lsgpShake{20%,60%{transform:translateX(-8px)}40%,80%{transform:translateX(8px)}}
.lsgp__bottom a{color:inherit;text-decoration:none;transition:color .3s}
.lsgp__bottom a:hover{color:#c6a664}
.lsgp .rise{opacity:0;transform:translateY(24px);animation:lsgpRise 1.4s cubic-bezier(.2,.7,.2,1) forwards}
@keyframes lsgpRise{to{opacity:1;transform:none}}
@media (max-width:700px){
.lsgp__top,.lsgp__bottom{padding:30px 28px;font-size:9px}
.lsgp__top .hide-m,.lsgp__bottom .hide-m{display:none}
.lsgp__frame{inset:12px}
.lsgp__sub{font-size:13px}
}
@media (prefers-reduced-motion:reduce){.lsgp *{animation:none!important;transition:none!important}.lsgp .rise{opacity:1;transform:none}}
.lsgp{overflow-y:auto}
.lsgp__media,.lsgp__shade,.lsgp__grain,.lsgp__frame{position:fixed}
.lsgp__main{flex:1 0 auto;padding:12px 24px}
@media (max-height:820px){.lsgp__top,.lsgp__bottom{padding:30px 44px}.lsgp__kicker{margin-bottom:18px}.lsgp__title{font-size:clamp(48px,min(11vw,15vh),130px)}.lsgp__line{height:28px;margin:20px auto 16px}.lsgp__sub{margin-bottom:22px;font-size:13px;line-height:1.6}}
@media (max-height:600px){.lsgp__title span{display:inline}.lsgp__title .sheen{margin-left:.2em}.lsgp__line{display:none}.lsgp__top,.lsgp__bottom{padding:24px 40px}}
</style>

<div class="lsgp" id="lsgp">
<div class="lsgp__media" aria-hidden="true">
<video class="on" muted autoplay playsinline preload="auto" src="https://videos.pexels.com/video-files/9760427/9760427-hd_1366_720_25fps.mp4"></video>
<video muted playsinline preload="auto" src="https://videos.pexels.com/video-files/9760434/9760434-hd_1366_720_25fps.mp4"></video>
</div>
<div class="lsgp__shade"></div>
<div class="lsgp__grain"></div>
<div class="lsgp__frame"></div>

<header class="lsgp__top rise" style="animation-delay:.2s">
<div class="lsgp__logo">Luxury Selection <em>Gallery</em></div>
<div class="hide-m">Argentina · MMXXVI</div>
</header>

<main class="lsgp__main">
<p class="lsgp__kicker rise" style="animation-delay:.5s">Private access · Acceso privado</p>
<h1 class="lsgp__title">
<span class="rise" style="animation-delay:.75s">Coming</span>
<span class="sheen rise" style="animation-delay:1s">soon.</span>
</h1>
<div class="lsgp__line rise" style="animation-delay:1.25s"></div>
<p class="lsgp__sub rise" style="animation-delay:1.4s">Una pieza. Un dueño.<br>Estamos preparando la nueva colección. Si tenés la clave, entrá antes que nadie.</p>

<div class="rise" style="animation-delay:1.6s;width:100%">
{% form 'storefront_password' %}
<div class="lsgp__form" id="lsgpForm">
<input type="password" name="password" id="lsgpPass" placeholder="Contraseña" autocomplete="current-password" required aria-label="Contraseña">
<button type="submit">Entrar <span aria-hidden="true">→</span></button>
</div>
<p class="lsgp__err" id="lsgpErr">{% if form.errors %}Contraseña incorrecta{% endif %}</p>
{% endform %}
</div>
</main>

<footer class="lsgp__bottom rise" style="animation-delay:1.8s">
<span>Piezas de diseñador seleccionadas</span>
<span class="hide-m">Luxury Selection Gallery</span>
</footer>
</div>

<script>
(function(){
var vids=document.querySelectorAll('#lsgp video'),i=0;
function play(n){
var v=vids[n];
try{v.currentTime=0}catch(e){}
var p=v.play(); if(p&&p.catch)p.catch(function(){});
vids.forEach(function(x,k){x.classList.toggle('on',k===n)});
}
vids.forEach(function(v,k){
v.addEventListener('ended',function(){ if(vids.length>1){ i=(k+1)%vids.length; play(i);} else {play(0);} });
});
play(0);
var err=document.getElementById('lsgpErr');
if(err){
var msg=err.textContent.trim();
if(msg){var f=document.getElementById('lsgpForm');f&&f.classList.add('shake');}
}
})();
</script>

{% schema %}{ "name": "Contraseña", "settings": [] }{% endschema %}
